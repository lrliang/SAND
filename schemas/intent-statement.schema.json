{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sand-framework.dev/schemas/intent-statement.schema.json",
  "title": "SAND Intent Statement",
  "description": "Structured intent statement with 7 user-defined fields + system-generated intent_id. Created by sand-create-intent Skill.",
  "type": "object",
  "required": [
    "intent_id",
    "intent_type",
    "purpose",
    "desired_outcome",
    "acceptance_criteria",
    "constraints",
    "meta"
  ],
  "properties": {
    "intent_id": {
      "type": "string",
      "pattern": "^INT-\\d{8}-\\d{3,}$",
      "description": "System-generated unique intent identifier (format: INT-YYYYMMDD-{seq}). Not part of the 7 user-defined fields."
    },
    "intent_type": {
      "type": "string",
      "enum": ["feature", "fix", "refactor", "exploration", "optimization"],
      "description": "Intent classification type affecting orchestration topology and HIP level defaults."
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "description": "Why: what business problem or user pain point this intent addresses. Must link to a traceable investment hypothesis or business goal."
    },
    "desired_outcome": {
      "type": "string",
      "minLength": 1,
      "description": "What success looks like: observable state changes, not implementation details."
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion", "verification", "priority"],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1,
            "description": "Testable condition that must be satisfied."
          },
          "verification": {
            "type": "string",
            "enum": ["automated_test", "human_review", "hybrid", "performance_benchmark"],
            "description": "How to verify this criterion."
          },
          "priority": {
            "type": "string",
            "enum": ["must", "should"],
            "description": "must = required for pass; should = best effort."
          }
        }
      },
      "minItems": 1,
      "description": "Structured acceptance criteria with verification method and priority."
    },
    "constraints": {
      "type": "object",
      "properties": {
        "technical": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Technical boundaries the implementation must respect."
        },
        "security": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Security constraints that must never be violated."
        },
        "scope": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Scope boundaries defining what is NOT included."
        }
      },
      "description": "Three-domain constraint structure: technical, security, scope."
    },
    "context_references": {
      "type": "object",
      "properties": {
        "architecture": { "type": "string", "description": "Architecture doc/section reference." },
        "domain_model": { "type": "string", "description": "Domain model reference." },
        "prior_decisions": { "type": "string", "description": "Relevant ADRs or prior decisions." },
        "related_intents": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Related intent IDs."
        },
        "known_risks": { "type": "string", "description": "Known risks or concerns." }
      },
      "description": "Structured references to related knowledge for implementation context."
    },
    "meta": {
      "type": "object",
      "required": ["owner", "status", "created"],
      "properties": {
        "owner": { "type": "string", "description": "Intent owner identifier." },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"],
          "description": "Business priority level."
        },
        "investment_hypothesis": { "type": "string", "description": "Linked investment hypothesis." },
        "estimated_ai_leverage": { "type": "string", "description": "Expected AI contribution estimate." },
        "created": { "type": "string", "format": "date-time", "description": "Creation timestamp." },
        "status": {
          "type": "string",
          "enum": ["draft", "reviewed", "approved", "in_execution", "validated", "archived"],
          "description": "Intent lifecycle status."
        }
      },
      "description": "Intent metadata including owner, priority, and lifecycle status."
    }
  },
  "additionalProperties": false
}
